# ==============================================================================
# Backend Environment Configuration
# Kaliluni Coffee Farmers Delivery System
# ==============================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:kalilunifcs@localhost:5432/kaliluni_coffee

# JWT Authentication
JWT_SECRET=kaliluni_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Email Service (SMTP) - Optional
# If omitted or invalid, password reset codes are printed to the server console simulator.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SERVICE=gmail
EMAIL_FROM="Kaliluni Coffee Cooperative" <no-reply@kaliluni.com>
